ext: nil, hints: nil)!\\nlet w = cg.width, h = cg.height\\nlet bpp = cg.bitsPerPixel/8, bpr = cg.bytesPerRow\\nlet data = cg.dataPro
vider!.data! as Data\\nlet ptr = (data as NSData).bytes.assumingMemoryBound(to: UInt8.self)\\nfunc lum(_ x: Int, _ y: Int) -> Double
{\\n    let off = y*bpr + x*bpp\\n    return 0.299*Double(ptr[off+2]) + 0.587*Double(ptr[off+1]) + 0.114*Double(ptr[off])\\n}\\n// p
