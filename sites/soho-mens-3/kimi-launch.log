            arguments='{"command":"cat <<\'EOF\' | swift -\\nimport AppKit\\nimport Foundation\\nlet img = NSImage(contentsOfFile: \
\"/tmp/figma_recents.png\\")!\\nvar rect = NSRect(origin: .zero, size: img.size)\\nlet cg = img.cgImage(forProposedRect: &rect, cont
ext: nil, hints: nil)!\\nlet w = cg.width, h = cg.height\\nlet bpp = cg.bitsPerPixel/8, bpr = cg.bytesPerRow\\nlet data = cg.dataPro
vider!.data! as Data\\nlet ptr = (data as NSData).bytes.assumingMemoryBound(to: UInt8.self)\\n\\n// grid of blueness: count \\"blue\
\" pixels per 40x40 cell\\nlet cell = 40\\nlet gw = w/cell, gh = h/cell\\nvar grid = [Int](repeating: 0, count: gw*gh)\\nfor y in 0.
.<h {\\n    for x in 0..<w {\\n        let off = y*bpr + x*bpp\\n        let b = Int(ptr[off]), g = Int(ptr[off+1]), r = Int(ptr[off
+2])\\n        // blue: blue channel dominant\\n        if b > 60 && b > r + 25 && b > g + 15 {\\n            grid[(y/cell)*gw + (x/
cell)] += 1\\n        }\\n    }\\n}\\n// print cells with significant blue counts\\nvar found = false\\nfor gy in 0..<gh {\\n    for
gx in 0..<gw {\\n        let c = grid[gy*gw+gx]\\n        if c > 200 { // >12.5% of cell pixels blue\\n            print(String(form
at: \\"BLUE_CELL x=%d y=%d count=%d (%.0f%%)\\", gx*cell+cell/2, gy*cell+cell/2, c, 100.0*Double(c)/Double(cell*cell)))\\n          
 found = true\\n        }\\n    }\\n}\\nif !found { print(\\"NO_STRONG_BLUE_CELLS\\") }\\nEOF","timeout":120}'
        ),
        extras=None
    )
