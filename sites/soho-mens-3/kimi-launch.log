vider!.data! as Data\\nlet ptr = (data as NSData).bytes.assumingMemoryBound(to: UInt8.self)\\nfunc rgb(_ x: Int, _ y: Int) -> (Doubl
e, Double, Double) {\\n    let off = y*bpr + x*bpp\\n    return (Double(ptr[off]), Double(ptr[off+1]), Double(ptr[off+2]))\\n}\\nlet
cols = 128, rows = 72\\nvar out = \\"\\"\\nfor r in 0..<rows {\\n    for c in 0..<cols {\\n        let x0 = c*w/cols, y0 = r*h/rows\
