ext: nil, hints: nil)!\\nlet w = cg.width, h = cg.height\\nlet bpp = cg.bitsPerPixel/8, bpr = cg.bytesPerRow\\nlet data = cg.dataPro
vider!.data! as Data\\nlet ptr = (data as NSData).bytes.assumingMemoryBound(to: UInt8.self)\\n// purple scan (figma #a259ff): R~162 
G~89 B~255; here dark-compressed, look for B>R>G pattern\\nvar hits: [(Int,Int)] = []\\nfor y in stride(from: 0, to: h, by: 4) {\\n 
  for x in stride(from: 0, to: w, by: 4) {\\n        let off = y*bpr + x*bpp\\n        let r = Int(ptr[off]), g = Int(ptr[off+1]), b
