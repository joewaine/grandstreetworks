    event=ToolCall(
        type='function',
        id='Shell_20',
        function=FunctionBody(
            name='Shell',
            arguments='{"command":"cat <<\'EOF\' | swift - | tesseract stdin stdout --psm 11 tsv 2>/dev/null | awk -F\'\\\\t\' \'NR=
=1 || ($12 != \\"\\" && $12 != \\" \\" && $11 > 40)\' | head -120\\nimport AppKit\\nimport Foundation\\nlet img = NSImage(contentsOf
File: \\"/tmp/figma_recents.png\\")!\\nvar rect = NSRect(origin: .zero, size: img.size)\\nlet cg = img.cgImage(forProposedRect: &rec
t, context: nil, hints: nil)!\\nlet w = cg.width, h = cg.height\\nlet bpp = cg.bitsPerPixel/8, bpr = cg.bytesPerRow\\nlet data = cg.
dataProvider!.data! as Data\\nlet ptr = (data as NSData).bytes.assumingMemoryBound(to: UInt8.self)\\nlet rep = NSBitmapImageRep(bitm
apDataPlanes: nil, pixelsWide: w, pixelsHigh: h, bitsPerSample: 8, samplesPerPixel: 1, hasAlpha: false, isPlanar: false, colorSpaceN
ame: .deviceWhite, bytesPerRow: 0, bitsPerPixel: 0)!\\nlet dst = rep.bitmapData!\\nlet dbpr = rep.bytesPerRow\\nfor y in 0..<h {\\n 
  for x in 0..<w {\\n        let off = y*bpr + x*bpp\\n        let l = 0.299*Double(ptr[off+2]) + 0.587*Double(ptr[off+1]) + 0.114*D
ouble(ptr[off])\\n        var v = (l - 19.0) * (255.0/(110.0-19.0))\\n        v = max(0, min(255, v))\\n        dst[y*dbpr + x] = UI
nt8(v)\\n    }\\n}\\nFileHandle.standardOutput.write(rep.representation(using: .png, properties: [:])!)\\nEOF","timeout":300}'
        ),
        extras=None
    )
)
