diff --git a/sites/soho-mens-4/styles.css b/sites/soho-mens-4/styles.css
new file mode 100644
index 0000000000000000000000000000000000000000..faa26b4db605fda1377a4fc6b00f74a605b3d277
--- /dev/null
+++ b/sites/soho-mens-4/styles.css
@@ -0,0 +1,750 @@
+@font-face {
+  font-family: "Newsreader";
+  src: url("assets/fonts/newsreader-latin.woff2") format("woff2");
+  font-style: normal;
+  font-weight: 400 600;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: "Newsreader";
+  src: url("assets/fonts/newsreader-italic-latin.woff2") format("woff2");
+  font-style: italic;
+  font-weight: 400;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: "DM Sans";
+  src: url("assets/fonts/dm-sans-latin.woff2") format("woff2");
+  font-style: normal;
+  font-weight: 400 700;
+  font-display: swap;
+}
+
+:root {
+  --ivory: #f5f0e7;
+  --paper: #fffcf7;
+  --espresso: #241c18;
+  --sage: #697b6b;
+  --sage-dark: #44564a;
+  --sage-pale: #dfe5dc;
+  --oxblood: #6b2632;
+  --oxblood-dark: #541b25;
+  --brass: #b08c57;
+  --line: #d8cec0;
+  --muted: #6f675f;
+  --error: #9a2e2e;
+  --shadow: 0 22px 54px rgb(36 28 24 / 12%);
+  --serif: "Newsreader", Georgia, serif;
+  --sans: "DM Sans", Arial, sans-serif;
+  --container: 1280px;
+  --radius-lg: 32px;
+  --radius-md: 20px;
+  --radius-sm: 12px;
+}
+
+*, *::before, *::after { box-sizing: border-box; }
+
+html {
+  scroll-behavior: smooth;
+  scroll-padding-top: 112px;
+}
+
+body {
+  margin: 0;
+  background: var(--ivory);
+  color: var(--espresso);
+  font-family: var(--sans);
+  font-size: 16px;
+  line-height: 1.55;
+  text-rendering: optimizeLegibility;
+  -webkit-font-smoothing: antialiased;
+}
+
+body.menu-open { overflow: hidden; }
+
+img { display: block; max-width: 100%; }
+a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 4px; }
+button, input, select { font: inherit; }
+button, a, select, input { -webkit-tap-highlight-color: transparent; }
+
+:focus-visible {
+  outline: 3px solid var(--brass);
+  outline-offset: 3px;
+}
+
+.sr-only {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+.skip-link {
+  position: fixed;
+  z-index: 100;
+  left: 20px;
+  top: 14px;
+  padding: 12px 18px;
+  border-radius: 10px;
+  background: var(--espresso);
+  color: white;
+  transform: translateY(-180%);
+  transition: transform 180ms ease-out;
+}
+
+.skip-link:focus { transform: translateY(0); }
+
+.site-header {
+  position: relative;
+  z-index: 20;
+  border-bottom: 1px solid rgb(36 28 24 / 10%);
+  background: var(--paper);
+}
+
+.utility {
+  display: flex;
+  min-height: 35px;
+  align-items: center;
+  justify-content: space-between;
+  padding: 6px max(32px, calc((100vw - var(--container)) / 2));
+  background: var(--sage-dark);
+  color: var(--ivory);
+  font-size: 12px;
+  font-weight: 600;
+  letter-spacing: .04em;
+}
+
+.utility p { margin: 0; }
+.utility a { text-decoration: none; }
+.utility a:hover { text-decoration: underline; }
+
+.nav-shell {
+  display: flex;
+  min-height: 88px;
+  max-width: calc(var(--container) + 64px);
+  margin: 0 auto;
+  padding: 0 32px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 36px;
+}
+
+.brand {
+  flex: 0 0 auto;
+  border-radius: 6px;
+}
+
+.brand img {
+  width: 218px;
+  height: auto;
+  mix-blend-mode: multiply;
+}
+
+.primary-nav {
+  display: flex;
+  align-items: center;
+  gap: clamp(18px, 2vw, 32px);
+}
+
+.primary-nav > a:not(.button) {
+  position: relative;
+  padding: 12px 0;
+  color: var(--espresso);
+  font-size: 14px;
+  font-weight: 600;
+  text-decoration: none;
+}
+
+.primary-nav > a:not(.button)::after {
+  position: absolute;
+  right: 0;
+  bottom: 6px;
+  left: 0;
+  height: 1px;
+  background: var(--oxblood);
+  content: "";
+  transform: scaleX(0);
+  transform-origin: left;
+  transition: transform 180ms ease-out;
+}
+
+.primary-nav > a:hover::after,
+.primary-nav > a[aria-current="page"]::after { transform: scaleX(1); }
+
+.menu-toggle { display: none; }
+
+.button {
+  display: inline-flex;
+  min-height: 56px;
+  align-items: center;
+  justify-content: center;
+  gap: 16px;
+  padding: 15px 24px;
+  border: 1px solid var(--oxblood);
+  border-radius: var(--radius-sm);
+  background: var(--oxblood);
+  color: white;
+  font-size: 14px;
+  font-weight: 700;
+  line-height: 1.25;
+  text-align: center;
+  text-decoration: none;
+  transition: background 180ms ease-out, border-color 180ms ease-out, transform 180ms ease-out;
+}
+
+.button:hover { border-color: var(--oxblood-dark); background: var(--oxblood-dark); transform: translateY(-2px); }
+.button:active { transform: translateY(0); }
+.button:disabled { cursor: wait; opacity: .68; transform: none; }
+.button-small { min-height: 46px; padding: 11px 18px; }
+.button-outline { border-color: var(--espresso); background: transparent; color: var(--espresso); }
+.button-outline:hover { border-color: var(--espresso); background: var(--espresso); color: var(--ivory); }
+.button-inverse { border-color: var(--paper); background: var(--paper); color: var(--espresso); }
+.button-inverse:hover { border-color: var(--ivory); background: var(--ivory); color: var(--espresso); }
+
+.text-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 20px;
+  border-bottom: 1px solid var(--espresso);
+  font-size: 14px;
+  font-weight: 700;
+  text-decoration: none;
+  transition: gap 180ms ease-out, color 180ms ease-out;
+}
+
+.text-link:hover { gap: 27px; color: var(--oxblood); }
+.text-link-light { border-color: var(--ivory); color: var(--ivory); }
+.text-link-light:hover { color: white; }
+
+.eyebrow {
+  margin: 0 0 18px;
+  color: var(--oxblood);
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: .18em;
+  line-height: 1.3;
+  text-transform: uppercase;
+}
+
+.eyebrow-light { color: #e6d8c6; }
+
+h1, h2, h3, p { margin-top: 0; }
+h1, h2, h3 { font-family: var(--serif); font-weight: 500; line-height: .98; }
+h1 em, h2 em { color: var(--oxblood); font-weight: 400; }
+
+.hero {
+  display: grid;
+  min-height: 730px;
+  max-width: calc(var(--container) + 64px);
+  margin: 0 auto;
+  padding: 72px 32px 86px;
+  grid-template-columns: minmax(0, .93fr) minmax(520px, 1.07fr);
+  align-items: center;
+  gap: 68px;
+  overflow: hidden;
+}
+
+.hero-copy { padding-left: 28px; }
+
+.hero h1 {
+  max-width: 630px;
+  margin-bottom: 28px;
+  font-size: clamp(64px, 6vw, 90px);
+  letter-spacing: -.035em;
+}
+
+.hero-deck {
+  max-width: 590px;
+  margin-bottom: 34px;
+  color: var(--muted);
+  font-size: 19px;
+  line-height: 1.55;
+}
+
+.hero-actions { display: flex; align-items: center; gap: 30px; }
+
+.credential-row {
+  display: flex;
+  margin: 56px 0 0;
+  padding: 24px 0 0;
+  border-top: 1px solid var(--line);
+  gap: 44px;
+}
+
+.credential-row div { min-width: 195px; }
+.credential-row dt { margin-bottom: 4px; color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
+.credential-row dd { margin: 0; font-family: var(--serif); font-size: 18px; font-weight: 500; }
+
+.hero-collage {
+  position: relative;
+  min-height: 585px;
+}
+
+.portrait-frame,
+.detail-frame {
+  position: absolute;
+  margin: 0;
+  overflow: hidden;
+  box-shadow: var(--shadow);
+}
+
+.portrait-frame {
+  top: 0;
+  right: 2%;
+  width: min(74%, 450px);
+  border-radius: 180px 180px 28px 28px;
+  background: var(--sage);
+}
+
+.portrait-frame img {
+  width: 100%;
+  height: 480px;
+  object-fit: cover;
+  object-position: 50% 18%;
+  filter: sepia(.08) saturate(.86) contrast(1.02);
+}
+
+.portrait-frame figcaption {
+  display: none;
+}
+
+.portrait-frame figcaption strong { font-size: 13px; }
+.portrait-frame figcaption span { color: var(--muted); text-align: left; }
+
+.detail-frame {
+  z-index: 2;
+  left: 0;
+  bottom: 12px;
+  width: 43%;
+  height: 230px;
+  border: 9px solid var(--ivory);
