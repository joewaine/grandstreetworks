+  .nav-shell { min-height: 78px; padding: 0 22px; }
+  .brand img { width: 196px; }
+  .menu-toggle { position: relative; z-index: 31; display: inline-flex; min-width: 72px; min-height: 44px; padding: 8px 10px; border: 0; background: transparent; color: var(--espresso); cursor: pointer; align-items: center; gap: 9px; }
+  .menu-label { font-size: 13px; font-weight: 700; }
+  .menu-icon, .menu-icon::before { display: block; width: 18px; height: 1px; background: currentColor; content: ""; transition: transform 180ms ease-out; }
+  .menu-icon::before { transform: translateY(6px); }
+  .menu-toggle[aria-expanded="true"] .menu-icon { transform: rotate(45deg); }
+  .menu-toggle[aria-expanded="true"] .menu-icon::before { transform: rotate(90deg); }
+  .primary-nav { position: fixed; z-index: 30; inset: 35px 0 0; display: flex; padding: 105px 28px 40px; background: var(--ivory); opacity: 0; visibility: hidden; transform: translateY(-14px); transition: opacity 180ms ease-out, transform 180ms ease-out, visibility 180ms; flex-direction: column; align-items: stretch; gap: 8px; }
+  .menu-open .primary-nav { opacity: 1; visibility: visible; transform: translateY(0); }
+  .primary-nav > a:not(.button) { padding: 15px 4px; border-bottom: 1px solid var(--line); font-family: var(--serif); font-size: 30px; font-weight: 500; }
