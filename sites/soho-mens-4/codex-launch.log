+  font-family: var(--serif);
+  font-size: 16px;
+  line-height: 1.25;
+}
+
+.collage-note span { display: block; margin-bottom: 5px; color: var(--brass); }
+
+.concierge-wrap {
+  position: relative;
+  z-index: 5;
+  max-width: calc(var(--container) + 64px);
+  margin: -20px auto 0;
+  padding: 0 32px;
+}
+
+.concierge {
+  display: grid;
+  padding: 30px 34px;
+  border-radius: 26px;
