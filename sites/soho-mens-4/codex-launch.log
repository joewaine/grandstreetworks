+      <div><p class="footer-label">Explore</p><a href="services.html">Services</a><a href="https://sohomenshealth.com/meet-the-doctor/">Meet the doctor</a><a href="https://sohomenshealth.com/prices/">Prices</a></div>
+      <div><p class="footer-label">Connect</p><a href="https://sohomenshealth.com/appointments/">Appointments</a><a href="https://sohomenshealth.com/contact-us/">Contact</a><a href="https://onpatient.com/">Patient portal</a></div>
+      <div><p class="footer-label">Call</p><a class="footer-phone" href="tel:+16463704050">646-370-4050</a><a href="mailto:info@sohosurgery.com">info@sohosurgery.com</a></div>
+    </div>
+    <div class="footer-bottom"><p>© <span id="year">2026</span> SoHo Men’s Health</p><p>Medical emergencies: call 911.</p></div>
+  </footer>
