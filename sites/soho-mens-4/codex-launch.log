+  .hero h1 { font-size: 67px; }
+  .portrait-frame img { height: 440px; }
+  .concierge { grid-template-columns: 1fr 260px 260px; }
+  .doctor-section { grid-template-columns: .8fr 1.2fr; }
+  .doctor-copy { padding: 80px 55px; }
+  .guest-book { grid-template-columns: .65fr 1.15fr .72fr; }
+  .guest-entry { padding: 28px; }
