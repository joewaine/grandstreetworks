+.section-heading > p { max-width: 520px; margin-bottom: 4px; color: var(--muted); font-size: 17px; }
+
+.service-grid {
+  display: grid;
+  margin-bottom: 40px;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 18px;
+}
+
+.service-room {
+  position: relative;
+  display: flex;
+  min-height: 345px;
+  padding: 29px;
