+  .portrait-frame { right: 0; width: 79%; border-radius: 140px 140px 22px 22px; }
+  .portrait-frame img { height: 382px; }
+  .detail-frame { left: 0; bottom: 7px; width: 43%; height: 175px; border-width: 7px; border-radius: 90px 18px 18px; }
+  .collage-note { right: 0; bottom: 2px; max-width: 185px; padding: 13px 14px; font-size: 13px; }
+  .concierge-wrap { margin-top: 0; padding: 0 12px; }
+  .concierge { padding: 27px 22px 29px; grid-template-columns: 1fr; gap: 24px; border-radius: 22px; }
+  .concierge > div:first-child { grid-column: auto; }
+  .concierge h2 { font-size: 29px; }
+  .field-message { position: static; display: block; margin-top: 4px; }
+  .section { padding: 82px 20px; }
+  .section-heading { margin-bottom: 38px; grid-template-columns: 1fr; gap: 24px; }
+  .section-heading h2, .locations-heading h2 { font-size: 51px; }
+  .section-heading > p { font-size: 15px; }
+  .service-grid { grid-template-columns: 1fr; }
+  .service-room { min-height: 310px; }
+  .service-room h3 { font-size: 36px; }
+  .doctor-photo { min-height: 530px; }
+  .doctor-copy { padding: 74px 22px; }
+  .doctor-copy h2 { font-size: 51px; }
+  .doctor-intro { font-size: 22px; }
+  .doctor-facts { grid-template-columns: 1fr; }
+  .doctor-facts p:nth-child(odd) { margin-right: 0; }
+  .visit-image { min-height: 430px; }
+  .visit-image::before { right: -10px; bottom: -14px; }
+  .visit-image img { height: 430px; border-radius: 130px 20px 20px; }
+  .visit-copy h2 { font-size: 51px; }
+  .guest-book { grid-template-columns: 1fr; }
+  .guest-entry, .guest-entry-large { min-height: 0; padding: 30px; }
+  .guest-entry blockquote, .guest-entry-large blockquote { font-size: 24px; }
+  .quiz-section { padding-right: 20px; padding-left: 20px; }
+  .quiz-section h2 { font-size: 42px; }
+  .quiz-links a { font-size: 20px; }
+  .location-grid { grid-template-columns: 1fr; }
+  .hours-card { grid-column: auto; }
+  .location-card, .hours-card { min-height: 355px; padding: 29px; }
+  .hours-card { min-height: auto; }
+  .site-footer { padding: 66px 22px 24px; }
+  .footer-main { grid-template-columns: 1fr 1fr; gap: 36px; }
+  .footer-main > div:first-child { grid-column: 1 / -1; }
+  .footer-main > div:last-child { grid-column: 1 / -1; }
+  .footer-bottom { align-items: flex-start; flex-direction: column; gap: 8px; }
+  .directory-hero { padding: 50px 20px 44px; }
+  .directory-hero h1 { font-size: 50px; }
+  .directory-hero > p:not(.eyebrow) { font-size: 16px; }
+  .directory-search { margin-top: 36px; }
+  .directory-search > div { grid-template-columns: 1fr; gap: 8px; }
+  .directory-search input, .directory-search button { border-radius: 11px; }
+  .directory-search button { min-height: 46px; border-left: 1px solid var(--paper); }
+  .directory { padding-top: 50px; }
+  .filter-row { flex-wrap: nowrap; margin-right: -20px; padding-right: 20px; overflow-x: auto; scrollbar-width: thin; }
+  .filter-chip { flex: 0 0 auto; }
+  .directory-grid { grid-template-columns: 1fr; }
+  .directory-room, .directory-room-wide { grid-column: auto; padding: 28px 24px; }
+  .directory-room header { grid-template-columns: 42px 1fr; }
+  .directory-room h2 { font-size: 34px; }
+  .service-columns { grid-template-columns: 1fr; gap: 28px; }
+  .services-cta { padding: 75px 20px; }
+  .services-cta h2 { font-size: 42px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  html { scroll-behavior: auto; }
+  *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; }
+}

