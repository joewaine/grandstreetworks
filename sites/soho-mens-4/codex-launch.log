+++ b/sites/soho-mens-4/index.html
@@ -0,0 +1,236 @@
+<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>SoHo Men's Health | Confidential Men's Health Care in NYC</title>
+  <meta name="description" content="Confidential, personalized men's health care with Dr. Kerem H. Bortecen in two Manhattan locations. Explore services or request an appointment.">
+  <link rel="canonical" href="https://sohomenshealth.com/">
+  <link rel="icon" href="assets/images/soho-logo.jpg" type="image/jpeg">
+  <link rel="preload" href="assets/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin>
+  <link rel="preload" href="assets/fonts/dm-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
+  <link rel="stylesheet" href="styles.css">
+  <script type="application/ld+json">
+  {
+    "@context": "https://schema.org",
+    "@type": "MedicalClinic",
+    "name": "SoHo Men’s Health",
+    "url": "https://sohomenshealth.com/",
+    "telephone": "+1-646-370-4050",
+    "faxNumber": "+1-347-474-7595",
+    "email": "info@sohosurgery.com",
+    "image": "https://s33929.pcdn.co/wp-content/uploads/sites/411/2021/06/DrKeremBortecen_6.jpg",
+    "location": [
+      {"@type":"Place","address":{"@type":"PostalAddress","streetAddress":"11 Broadway, Suite 570","addressLocality":"New York","addressRegion":"NY","postalCode":"10004","addressCountry":"US"}},
+      {"@type":"Place","address":{"@type":"PostalAddress","streetAddress":"30 Central Park South, Suite 10A","addressLocality":"New York","addressRegion":"NY","postalCode":"10019","addressCountry":"US"}}
+    ],
+    "sameAs": ["https://www.facebook.com/sohomenshealth/", "https://twitter.com/SohoMensHealth"]
+  }
+  </script>
+</head>
+<body>
+  <a class="skip-link" href="#main">Skip to main content</a>
+  <header class="site-header">
+    <div class="utility">
+      <p>Private specialty care for men in Manhattan</p>
+      <a href="tel:+16463704050" aria-label="Call SoHo Men's Health at 646-370-4050">Call <span>646-370-4050</span></a>
+    </div>
+    <div class="nav-shell">
+      <a class="brand" href="index.html" aria-label="SoHo Men's Health home">
+        <img src="assets/images/soho-logo.jpg" width="262" height="71" alt="SoHo Men's Health — Providing Excellent Care">
+      </a>
+      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
+        <span class="menu-label">Menu</span><span class="menu-icon" aria-hidden="true"></span>
+      </button>
+      <nav id="primary-navigation" class="primary-nav" aria-label="Primary navigation">
+        <a href="services.html">Services</a>
+        <a href="#doctor">The doctor</a>
+        <a href="#guest-book">Guest book</a>
+        <a href="#locations">Locations</a>
+        <a href="https://onpatient.com/" target="_blank" rel="noopener">Patient portal<span class="sr-only"> (opens in a new tab)</span></a>
+        <a class="button button-small" href="https://sohomenshealth.com/appointments/">Request appointment</a>
+      </nav>
+    </div>
+  </header>
+
+  <main id="main">
+    <section class="hero" aria-labelledby="hero-title">
+      <div class="hero-copy">
+        <p class="eyebrow">SoHo Men’s Health · New York City</p>
+        <h1 id="hero-title">Private care,<br><em>properly personal.</em></h1>
+        <p class="hero-deck">Confidential, personalized specialty care for men—guided by surgeon-scientist Dr. Kerem H. Bortecen and delivered in two Manhattan offices.</p>
+        <div class="hero-actions">
+          <a class="button" href="https://sohomenshealth.com/appointments/">Request an appointment <span aria-hidden="true">↗</span></a>
+          <a class="text-link" href="services.html">Explore all services <span aria-hidden="true">→</span></a>
+        </div>
+        <dl class="credential-row" aria-label="Practice highlights">
+          <div><dt>Founder</dt><dd>MD · PhD · MBA · FACS</dd></div>
+          <div><dt>Access</dt><dd>Two Manhattan locations</dd></div>
+        </dl>
+      </div>
+      <div class="hero-collage" aria-label="Dr. Kerem Bortecen and a private consultation">
+        <figure class="portrait-frame">
+          <img src="assets/images/dr-bortecen.webp" width="720" height="868" alt="Dr. Kerem H. Bortecen" fetchpriority="high">
+          <figcaption><strong>Kerem H. Bortecen</strong><span>Founder &amp; Surgical Director</span></figcaption>
+        </figure>
+        <figure class="detail-frame">
+          <img src="assets/images/consultation-hands.webp" width="1200" height="801" alt="Hands during a private medical consultation" fetchpriority="high">
+        </figure>
+        <p class="collage-note"><span aria-hidden="true">✦</span> Your comfort and privacy are priorities here.</p>
+      </div>
+    </section>
+
+    <section class="concierge-wrap" aria-labelledby="concierge-title">
+      <form class="concierge" id="concierge-form" novalidate>
+        <div>
+          <p class="eyebrow eyebrow-light">Your visit, hosted</p>
+          <h2 id="concierge-title">When would you like to come in?</h2>
+        </div>
+        <div class="concierge-control">
+          <label for="location">Preferred location</label>
+          <select id="location" name="location" required aria-describedby="location-message">
+            <option value="">Choose an office</option>
+            <option value="broadway">11 Broadway, Suite 570</option>
+            <option value="central-park">30 Central Park South, Suite 10A</option>
+          </select>
+          <span id="location-message" class="field-message" aria-live="polite"></span>
+        </div>
+        <button class="button button-inverse" type="submit">Continue to appointment request <span aria-hidden="true">→</span></button>
+      </form>
+    </section>
+
+    <section class="services-preview section" aria-labelledby="services-title">
+      <div class="section-heading">
+        <div>
+          <p class="eyebrow">A practice for the whole man</p>
+          <h2 id="services-title">Start with what’s<br><em>on your mind.</em></h2>
+        </div>
+        <p>From hormonal and sexual health to surgical conditions, pain, recovery, aesthetics and prevention—the practice brings a broad range of men’s health services into one physician-led setting.</p>
+      </div>
+      <div class="service-grid">
+        <a class="service-room room-featured" href="services.html#sexual-reproductive">
+          <span class="room-number">01</span><h3>Sexual &amp;<br>reproductive health</h3>
+          <p>Penis, prostate, pelvic floor and anal health.</p><span class="room-arrow" aria-hidden="true">↗</span>
+        </a>
+        <a class="service-room" href="services.html#hormonal">
+          <span class="room-number">02</span><h3>Hormonal<br>therapy</h3>
+          <p>Testing, bioidentical hormones and testosterone therapy.</p><span class="room-arrow" aria-hidden="true">↗</span>
+        </a>
+        <a class="service-room" href="services.html#surgical">
+          <span class="room-number">03</span><h3>Surgical<br>diseases</h3>
+          <p>Specialty care informed by surgical training and continuity.</p><span class="room-arrow" aria-hidden="true">↗</span>
+        </a>
+        <a class="service-room room-image" href="services.html#pain-recovery">
+          <img src="assets/images/consultation-room.webp" width="1200" height="800" alt="Doctor speaking with a patient in a consultation room" loading="lazy">
+          <span class="room-image-label">Pain management &amp; recovery <span aria-hidden="true">↗</span></span>
+        </a>
+        <a class="service-room" href="services.html#rejuvenation">
+          <span class="room-number">04</span><h3>Rejuvenation<br>&amp; aesthetics</h3>
+          <p>PRP, skin, hair, injectables and body treatments.</p><span class="room-arrow" aria-hidden="true">↗</span>
+        </a>
+        <a class="service-room room-quiet" href="services.html#wellness">
+          <span class="room-number">05</span><h3>Wellness,<br>screening &amp; prevention</h3>
+          <p>Education and proactive support for long-term health.</p><span class="room-arrow" aria-hidden="true">↗</span>
+        </a>
+      </div>
+      <a class="button button-outline" href="services.html">View the complete service directory <span aria-hidden="true">→</span></a>
+    </section>
+
+    <section class="doctor-section section" id="doctor" aria-labelledby="doctor-title">
+      <div class="doctor-photo">
+        <img src="assets/images/dr-bortecen.webp" width="720" height="868" alt="Portrait of Dr. Kerem H. Bortecen" loading="lazy">
+        <p>Founder &amp; Surgical Director<br>SoHo Men’s Health</p>
+      </div>
+      <div class="doctor-copy">
+        <p class="eyebrow eyebrow-light">Warmth, with weight behind it</p>
+        <h2 id="doctor-title">Kerem H. Bortecen,<br><em>MD, PhD, MBA, FACS</em></h2>
+        <p class="doctor-intro">An internationally recognized, Ivy League-trained surgeon-scientist with awards and peer-reviewed publications.</p>
+        <div class="doctor-facts">
+          <p><strong>Oxford University</strong><span>PhD</span></p>
+          <p><strong>University of Toronto</strong><span>MBA</span></p>
+          <p><strong>Yale · University of Pennsylvania</strong><span>Surgical training</span></p>
+          <p><strong>American College of Surgeons</strong><span>Fellow</span></p>
+        </div>
+        <p>Dr. Bortecen fulfills his mission through surgical excellence, personalized medicine and continuity of care.</p>
+        <a class="text-link text-link-light" href="https://sohomenshealth.com/meet-the-doctor/">Meet Dr. Bortecen <span aria-hidden="true">↗</span></a>
+      </div>
+    </section>
+
+    <section class="visit-section section" aria-labelledby="visit-title">
