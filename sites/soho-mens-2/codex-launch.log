+  padding: .85rem 1.45rem;
+  border: 1px solid transparent;
+  border-radius: .25rem;
+  font-size: .78rem;
+  font-weight: 700;
+  line-height: 1.2;
+  text-align: center;
+  text-decoration: none;
+  transition: background-color 180ms ease-out, border-color 180ms ease-out, color 180ms ease-out;
+}
+
+.button--primary { color: var(--white); background: var(--ink); }
+.button--primary:hover { background: var(--ink-2); }
+.button--secondary { border-color: var(--ink); color: var(--ink); background: transparent; }
