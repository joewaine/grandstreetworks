+  border-top: 1px solid var(--line);
+}
+.trust-strip div { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 1.35rem; }
+.trust-strip dt { font-family: var(--font-serif); color: var(--ink); font-size: 2rem; line-height: 1; }
+.trust-strip dd { margin: 0; color: var(--muted); font-size: .68rem; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; }
+
+.section-dark { color: var(--mint); background: var(--ink); }
+.care-paths { padding: 7.2rem max(4.5rem, calc((100% - 1296px) / 2)) 8.5rem; }
+.care-paths h2 { color: var(--white); }
+.section-intro { max-width: 56rem; }
+.section-intro > p:last-child { color: var(--muted); font-size: 1.05rem; }
+.section-intro--split { display: grid; grid-template-columns: 1.2fr .8fr; gap: 5rem; max-width: none; align-items: end; }
+.section-intro--split > p { max-width: 28rem; margin-bottom: 2rem; color: var(--mint); }
+
+.path-list { margin: 5rem 0 0; padding: 0; border-bottom: 1px solid #547067; list-style: none; }
+.path-list li { border-top: 1px solid #547067; }
