+    <section class="locations-section" id="locations" aria-labelledby="locations-title">
+      <div class="section-intro">
+        <p class="eyebrow">05 <span aria-hidden="true">·</span> Practical access</p>
+        <h2 id="locations-title">Two Manhattan locations.</h2>
+      </div>
+      <div class="location-grid">
+        <article>
+          <p class="location-label">Downtown</p>
+          <address>11 Broadway, Suite 570<br>New York, NY 10004</address>
+          <a class="text-link" href="https://g.page/r/CUKFjXq2fwzSEBA" rel="external">Get directions <span aria-hidden="true">↗</span></a>
+        </article>
+        <article>
+          <p class="location-label">Central Park South</p>
+          <address>30 Central Park South, Suite 10A<br>New York, NY 10019</address>
+          <a class="text-link" href="https://g.page/soho-men-s-health" rel="external">Get directions <span aria-hidden="true">↗</span></a>
+        </article>
+        <div class="hours">
+          <a href="tel:+16463704050">646-370-4050</a>
+          <dl>
+            <div><dt>Monday–Friday</dt><dd>8am–8pm</dd></div>
+            <div><dt>Saturday</dt><dd>8am–1pm</dd></div>
+            <div><dt>Sunday</dt><dd>Closed</dd></div>
+          </dl>
+          <p>Fax: 347-474-7595</p>
+        </div>
+      </div>
+    </section>
+  </main>
+
+  <footer class="site-footer">
+    <div class="footer-brand">
+      <p>SoHo Men's Health</p>
+      <span>Confidential &amp; personalized care in Manhattan.</span>
+    </div>
+    <nav aria-label="Footer navigation">
+      <a href="#care-paths">Care paths</a>
+      <a href="https://sohomenshealth.com/meet-the-doctor/">Meet the doctor</a>
+      <a href="https://onpatient.com/" rel="external">Patient portal</a>
+      <a href="https://sohomenshealth.com/price-list/">Prices</a>
+      <a href="https://www.sohomensbeauty.com/" rel="external">SoHo Men's Beauty</a>
+    </nav>
+    <div class="insurance-note">
+      <p><strong>Please note:</strong> We are out of network. Upon request, we will provide a detailed breakdown and coding should you wish to make an insurance claim.</p>
+      <a class="button button--clay" href="https://sohomenshealth.com/appointments/">Request appointment</a>
+    </div>
+    <div class="footer-meta">
+      <span>© SoHo Men's Health</span>
