@@ -0,0 +1,396 @@
+@font-face {
+  font-family: "Lora";
+  src: url("assets/lora-latin.woff2") format("woff2");
+  font-style: normal;
+  font-weight: 400 700;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: "Montserrat";
+  src: url("assets/montserrat-latin.woff2") format("woff2");
+  font-style: normal;
+  font-weight: 400 800;
