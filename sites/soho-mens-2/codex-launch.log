@@ -0,0 +1,396 @@
+@font-face {
+  font-family: "Lora";
+  src: url("assets/lora-latin.woff2") format("woff2");
+  font-style: normal;
+  font-weight: 400 700;
+  font-display: swap;
+}
+
+@font-face {
+  font-family: "Montserrat";
+  src: url("assets/montserrat-latin.woff2") format("woff2");
+  font-style: normal;
+  font-weight: 400 800;
+  font-display: swap;
+}
+
+:root {
+  --ink: #142723;
+  --ink-2: #203b35;
+  --mineral: #6f8f80;
+  --mineral-dark: #476658;
+  --mint: #dce8e0;
