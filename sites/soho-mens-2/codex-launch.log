+          <a class="text-link" href="https://g.page/r/CUKFjXq2fwzSEBA" rel="external">Get directions <span aria-hidden="true">↗</span></a>
+        </article>
+        <article>
+          <p class="location-label">Central Park South</p>
+          <address>30 Central Park South, Suite 10A<br>New York, NY 10019</address>
+          <a class="text-link" href="https://g.page/soho-men-s-health" rel="external">Get directions <span aria-hidden="true">↗</span></a>
+        </article>
+        <div class="hours">
+          <a href="tel:+16463704050">646-370-4050</a>
+          <dl>
+            <div><dt>Monday–Friday</dt><dd>8am–8pm</dd></div>
