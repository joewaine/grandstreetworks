+  --ink: #142723;
+  --ink-2: #203b35;
+  --mineral: #6f8f80;
+  --mineral-dark: #476658;
+  --mint: #dce8e0;
+  --paper: #f5f1e8;
+  --white: #fffefa;
+  --clay: #b8674f;
+  --gold: #9a7631;
+  --text: #1c2926;
+  --muted: #5c6965;
