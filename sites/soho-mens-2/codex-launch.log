+  font-weight: 400 800;
+  font-display: swap;
+}
+
+:root {
+  --ink: #142723;
+  --ink-2: #203b35;
+  --mineral: #6f8f80;
+  --mineral-dark: #476658;
+  --mint: #dce8e0;
