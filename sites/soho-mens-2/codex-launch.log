+  min-height: 3.35rem;
+  align-items: center;
+  justify-content: center;
+  padding: .85rem 1.45rem;
+  border: 1px solid transparent;
+  border-radius: .25rem;
+  font-size: .78rem;
+  font-weight: 700;
+  line-height: 1.2;
+  text-align: center;
